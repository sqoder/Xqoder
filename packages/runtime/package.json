{
    "name": "@xqoder/runtime",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "XQoder Project Runtime - run, monitor, and capture errors",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "test:integration": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "tsc --noEmit"
    },
    "dependencies": {
        "@xqoder/permissions": "workspace:*",
        "@xqoder/plugin-sdk": "workspace:*",
        "@xqoder/protocol": "workspace:*",
        "@xqoder/shared": "workspace:*",
        "dockerode": "^4.0.0",
        "tree-kill": "^1.2.2"
    },
    "devDependencies": {
        "@types/dockerode": "^3.3.0",
        "@types/node": "^22.0.0",
        "typescript": "^5.4.0",
        "vitest": "^2.0.0"
    }
}
