# Release-check generated artifacts — CI uploads these as workflow
# artifacts; committing them causes dirty-worktree noise locally.
docs/release/latest-*

# Golden-task live-run workspaces — each run wipes and repopulates from
# docs/golden-tasks/fixtures/live-coding/ templates, so the tmp copies
# must never be committed.
tmp/golden-workspaces/

