{
    "name": "xqoder",
    "version": "0.1.0-rc.202603230340",
    "private": true,
    "type": "module",
    "description": "XQoder - terminal-native AI coding assistant",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "xqoder": "./dist/index.js"
    },
    "scripts": {
        "build": "bun scripts/build.mjs",
        "dev": "bun scripts/build.mjs --watch",
        "start": "bun dist/index.js",
        "xqoder": "bun dist/index.js",
        "demo:mvp:typeerror": "bun run scripts/run-mvp-typeerror-demo.ts",
        "demo:mvp:typeerror:cli": "bun run scripts/run-mvp-typeerror-cli-demo.ts",
        "clean": "rm -rf dist",
        "test": "bun test ./test ./src",
        "test:vscode-extension": "bun test test/vscode-extension",
        "test:coverage": "node scripts/check-coverage.mjs",
        "eval:golden": "bun run scripts/run-golden-tasks.ts --manifest docs/golden-tasks/xqoder-internal.sample.json",
        "eval:golden:live": "bun run scripts/run-golden-tasks.ts --manifest docs/golden-tasks/xqoder-live-coding.json --live",
        "acceptance:metrics": "bun run scripts/run-golden-tasks.ts --manifest docs/golden-tasks/xqoder-live-coding.json --dry-run",
        "lint": "bun x tsc --noEmit",
        "lint:application-chat-strict": "bun x tsc -p tsconfig.application-chat-strict.json --noEmit",
        "lint:platform-terminal-strict": "bun x tsc -p tsconfig.platform-terminal-strict.json --noEmit",
        "lint:core-agent-protocol-strict": "bun x tsc -p tsconfig.core-agent-protocol-strict.json --noEmit",
        "lint:interfaces-http-openapi-exact-optional": "bun x tsc -p tsconfig.interfaces-http-openapi-exact-optional.json --noEmit",
        "lint:layers-strict": "bun x tsc -p tsconfig.domain-shared-strict.json --noEmit",
        "lint:domain-exact-optional": "bun x tsc -p tsconfig.domain-exact-optional.json --noEmit",
        "lint:application-system-exact-optional": "bun x tsc -p tsconfig.application-system-exact-optional.json --noEmit",
        "lint:application-permissions-sessions-exact-optional": "bun x tsc -p tsconfig.application-permissions-sessions-exact-optional.json --noEmit",
        "e2e:smoke": "node scripts/cli-smoke.mjs",
        "mcp:live-smoke": "bun run scripts/mcp-live-smoke.ts",
        "signoff:ac01": "node scripts/run-manual-e2e.mjs --ac01-signoff",
        "signoff:ci-fresh-evidence": "node scripts/run-manual-e2e.mjs --ci-fresh-evidence",
        "signoff:release-freeze-evidence": "node scripts/run-manual-e2e.mjs --release-branch-freeze-evidence",
        "acceptance:metrics:live": "bun run scripts/run-golden-tasks.ts --manifest docs/golden-tasks/xqoder-live-coding.json --live",
        "local:repair-runtime-state": "node scripts/repair-local-runtime-state.mjs",
        "security:hygiene": "node scripts/security-tracked-files.mjs",
        "security:tracked": "bun run security:hygiene",
        "size:guardrail": "node scripts/check-file-size-guardrail.mjs",
        "release:check": "bun run build && bun x tsc -p apps/vscode-extension/tsconfig.json && bun run test:vscode-extension && bun run lint && bun run lint:application-chat-strict && bun run lint:platform-terminal-strict && bun run lint:core-agent-protocol-strict && bun run lint:interfaces-http-openapi-exact-optional && bun run lint:layers-strict && bun run lint:domain-exact-optional && bun run lint:application-system-exact-optional && bun run lint:application-permissions-sessions-exact-optional && bun run test:coverage && bun run e2e:smoke && bun run mcp:live-smoke && bun run security:hygiene && bun run size:guardrail",
        "omx:audit-runtime-artifacts": "node scripts/audit-omx-runtime-artifacts.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.88.0",
        "better-sqlite3": "^12.2.0",
        "chalk": "^5.3.0",
        "chardet": "^2.1.1",
        "clipboardy": "^4.0.0",
        "commander": "^12.0.0",
        "execa": "^9.6.1",
        "file-type": "^22.0.1",
        "iconv-lite": "^0.7.2",
        "ink": "^6.8.0",
        "istextorbinary": "^9.5.0",
        "mammoth": "^1.12.0",
        "openai": "^6.34.0",
        "pdfjs-dist": "^5.6.205",
        "react": "^19.2.4",
        "string-width": "4.2.3",
        "tree-kill": "^1.2.2"
    },
    "devDependencies": {
        "@types/node": "^22.19.15",
        "@types/better-sqlite3": "^7.6.13",
        "@types/react": "^19.2.2",
        "bun-types": "^1.3.12",
        "typescript": "^5.4.0"
    }
}
