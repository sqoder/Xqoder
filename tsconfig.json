{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "types": ["node", "react", "bun-types"],
    "baseUrl": ".",
    "paths": {
      "@xqoder/bootstrap/*": ["./src/bootstrap/*"],
      "@xqoder/interfaces/*": ["./src/interfaces/*"],
      "@xqoder/application/*": ["./src/application/*"],
      "@xqoder/domain/*": ["./src/domain/*"],
      "@xqoder/infrastructure/*": ["./src/infrastructure/*"],
      "@xqoder/foundation-shared/*": ["./src/shared/*"],
      "@xqoder/shared": ["./src/infra/shared"],
      "@xqoder/protocol": ["./src/infra/protocol"],
      "@xqoder/llm-api": ["./src/infra/llm"],
      "@xqoder/permissions": ["./src/infra/permissions"],
      "@xqoder/agent": ["./src/core/agent"],
      "@xqoder/core-runtime": ["./src/core/runtime"],
      "@xqoder/plugin-sdk": ["./src/infra/plugin-sdk"],
      "@xqoder/provider-openai": ["./src/infra/llm/openai/provider"],
      "@xqoder/provider-anthropic": ["./src/infra/llm/anthropic"],
      "@xqoder/runtime": ["./src/features/runtime"],
      "@xqoder/deploy": ["./src/features/deploy"],
      "@xqoder/storage-sqlite": ["./src/infra/storage"],
      "@xqoder/workflow": ["./src/core/workflow"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
